{
  "name": "@zync-sh/plugin-ui",
  "version": "0.1.0-beta.1",
  "description": "Sandbox-safe themed UI primitives for Zync plugins",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/zync-sh/plugin-ui.git" },
  "engines": { "node": ">=20" },
  "sideEffects": ["./styles.css"],
  "files": ["index.js", "index.d.ts", "theme.js", "select.js", "tooltips.js", "styles.css", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "scripts": {
    "type-check": "tsc -p tsconfig.test.json",
    "test": "node tests/pluginUiPackage.test.mjs",
    "prepublishOnly": "npm run type-check && npm test"
  },
  "devDependencies": { "typescript": "~5.8.3" },
  "publishConfig": { "access": "public", "tag": "beta" }
}
